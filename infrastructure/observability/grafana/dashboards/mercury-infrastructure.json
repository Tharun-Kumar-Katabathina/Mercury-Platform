  {
   "id": 4,
   "type": "timeseries",
   "title": "Memory per container (short id)",
   "description": "docker ps shows which id is which service",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "label_replace(container_memory_working_set_bytes{id=~\"/docker/[0-9a-f]{64}\"}, \"cid\", \"$1\", \"id\", \"/docker/(.{12}).*\")",
     "legendFormat": "{{cid}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 1,
