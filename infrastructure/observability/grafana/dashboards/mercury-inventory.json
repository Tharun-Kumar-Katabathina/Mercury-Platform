{
 "uid": "mercury-inventory",
 "title": "Inventory",
 "tags": [
  "mercury",
  "inventory"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
