# Do not copy this file by hand: run scripts/init-secrets.sh, which writes a .env with random values (and the JWT keys).
# This file only documents the variables. Everything below is a secret except the last three.
POSTGRES_USER=mercury
POSTGRES_PASSWORD=
ADMIN_EMAIL=admin@mercury.local
ADMIN_PASSWORD=
ORDER_SERVICE_SECRET=
PRODUCT_SERVICE_SECRET=
GRAFANA_ADMIN_PASSWORD=
MERCURY_VERSION=dev
ORDER_RESERVATION_MODE=SYNC
# numeric group that owns .secrets/jwt-private.pem; the user-service container joins it to read the key (init-secrets.sh sets it)
JWT_PRIVATE_KEY_GID=
