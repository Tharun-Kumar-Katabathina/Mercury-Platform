# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.
POSTGRES_USER=mercury
# Required for `docker compose -f docker-compose.yml ...`. The developer override falls back to "mercury"
# so that `docker compose up -d postgres kafka` keeps working with an existing local volume.
POSTGRES_PASSWORD=change-me
# Image tag for the service images, and the order flow to run (SYNC | ASYNC)
MERCURY_VERSION=dev
ORDER_RESERVATION_MODE=SYNC
