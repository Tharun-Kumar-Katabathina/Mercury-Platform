# Throw-away helper that shares a container's network namespace to add latency or loss with `tc netem`.
# The services' own images stay minimal and unprivileged; only this helper gets NET_ADMIN, and only while injecting.
#
# It does not run as root. Docker gives a non-root user no ambient capabilities, so `tc` carries the one capability it needs
# as a file capability (cap_net_admin): it works only when the caller also adds NET_ADMIN (`docker run --cap-add=NET_ADMIN`)
# and fails with "operation not permitted" otherwise. setcap is installed only to set it and removed again.
FROM alpine:3.20
RUN apk add --no-cache iproute2 libcap \
 && setcap cap_net_admin+ep "$(readlink -f /sbin/tc)" \
 && apk del libcap
USER 65534:65534
ENTRYPOINT ["tc"]
