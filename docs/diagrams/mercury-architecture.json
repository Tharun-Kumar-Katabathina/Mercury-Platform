  "cards": [
    {
      "dot": "cyan",
      "title": "Synchronous (REST)",
      "items": [
        "Client reaches services only through the gateway",
        "Order validates products, then reserves stock (SYNC mode, the default)",
        "Inventory has no gateway route"
      ]
    },
    {
      "dot": "amber",
      "title": "Asynchronous (Kafka)",
      "items": [
        "Services write events to a transactional outbox, then a publisher sends them",
        "ASYNC mode: Order sends a reservation command, Inventory answers with a reply",
        "Notification and Recommendation consume order events in their own groups"
      ]
    },
    {
      "dot": "rose",
      "title": "Security + data",
      "items": [
        "User Service issues RS256 JWTs; the gateway verifies them",
        "One PostgreSQL server, one database per service (named on each node)",
        "Redis holds cache only; nothing is stored only there"
      ]
    }
  ]
