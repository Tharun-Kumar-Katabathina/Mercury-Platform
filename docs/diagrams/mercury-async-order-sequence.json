  "cards": [
    {
      "dot": "emerald",
      "title": "Accept fast",
      "items": [
        "Order answers 202 after one local transaction",
        "The reservation command is an outbox row, not a live call",
        "Same Idempotency-Key replays the same order"
      ]
    },
    {
      "dot": "amber",
      "title": "Reply or deadline",
      "items": [
        "Inventory reserves every item atomically, or rejects the order",
        "No reply by the deadline: Order asks Inventory directly",
        "An unreachable Inventory never cancels an order on a guess"
      ]
    },
    {
      "dot": "violet",
      "title": "Delivery",
      "items": [
        "Outbox publishers give at-least-once delivery",
        "Consumers store processed event ids, so duplicates change nothing",
        "Clients poll GET /orders/{id} until the order is CONFIRMED or CANCELLED"
      ]
    }
  ]
